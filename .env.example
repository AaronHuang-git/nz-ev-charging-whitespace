# .env.example
# Copy this file to `.env` in the repo root and fill in your values.
# .env is gitignored — NEVER commit a populated copy.
#
# These variables are read by:
#   - scripts/load_statsnz_population.py
#   - scripts/load_linz_ta_boundaries.py
#   - scripts/build_ta_name_seed.py
#   - dbt profile (via env_var() in ~/.dbt/profiles.yml)

# Snowflake account locator (e.g. "abc12345.us-east-1" or "xy12345" for legacy format)
SNOWFLAKE_ACCOUNT=<your-account-locator>

# Snowflake user — the one whose RSA public key was registered via ALTER USER
SNOWFLAKE_USER=<your-snowflake-user>

# Role, warehouse, database — defaults below match what snowflake/ddl/ creates
SNOWFLAKE_ROLE=FIRN_EV_DEV_OWNER
SNOWFLAKE_WAREHOUSE=FIRN_EV_XS_WH
SNOWFLAKE_DATABASE=FIRN_EV_DEV

# Absolute or ~-expanded path to your unencrypted PKCS#8 RSA private key (.p8)
# Generate with:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out firn_ev_rsa_key.p8 -nocrypt
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/firn_ev_rsa_key.p8
