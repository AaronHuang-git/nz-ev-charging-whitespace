	partition FCT_CHARGING_STATION = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases("<your-snowflake-account>.snowflakecomputing.com", "FIRN_EV_XS_WH"),
				    FIRN_EV_DEV_Database = Source{[Name="FIRN_EV_DEV",Kind="Database"]}[Data],
				    QueryResult = Value.NativeQuery(
				        FIRN_EV_DEV_Database,
				        "SELECT station_id, operator_key, ta_key, first_operational_date_key, station_name, address, latitude, longitude, canonical_ta_name, region_name, island, is_overridden, operator_name, reported_connector_count, operative_connector_count, total_operative_kw, max_operative_kw, dc_fast_connector_count, ultrafast_connector_count, has_dc_fast, has_ultrafast FROM GOLD.FCT_CHARGING_STATION"
				    )
				in
				    QueryResult

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

